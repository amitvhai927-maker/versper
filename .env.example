# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database & Cache
DATABASE_URL="postgres://postgres:vesperpass@localhost:5432/vesper_db"
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="vesper_jwt_super_secret_production_key_min_32_characters"
REFRESH_TOKEN_SECRET="vesper_refresh_super_secret_production_key_min_32"

# S3-Compatible Object Storage
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_BUCKET="vesper-media-vault"
STORAGE_ACCESS_KEY="vesper_storage_access_key"
STORAGE_SECRET_KEY="vesper_storage_secret_key"
STORAGE_REGION="us-east-1"

# Push Notifications (Firebase Cloud Messaging & APNs)
FCM_PROJECT_ID="vesper-messenger-app"
FCM_SERVER_KEY="AIzaSyDummyFCMServerKeyForProductionPush"
APNS_KEY_ID="ABC123DEF4"
APNS_TEAM_ID="TEAM123456"
APNS_BUNDLE_ID="org.vesper.messenger"

# WebRTC STUN/TURN Infrastructure
TURN_SERVER="turn:turn.vespermessenger.org:3478"
TURN_USERNAME="turn_vesper_user"
TURN_PASSWORD="turn_vesper_secure_password"

